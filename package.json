{
  "name": "starship-prototype-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy": "npx firebase-tools deploy --only hosting --project blackstarspace",
    "typecheck:missoes": "tsc --noEmit -p tsconfig.missoes.json",
    "missao:executar": "vite-node scripts/executar-missao.ts",
    "agua:validar": "vite-node scripts/validar-hidrodinamica.ts",
    "missao:benchmark": "vite-node scripts/benchmark-missao.ts",
    "docs:gerar": "vite-node scripts/auditar-documentacao.ts --gerar",
    "docs:verificar": "vite-node scripts/auditar-documentacao.ts",
    "test:documentacao": "vitest run scripts/documentacao",
    "preparar:deploy": "npm run typecheck && npm run docs:verificar && npm run build && npm run site:verificar",
    "site:verificar": "vite-node scripts/verificar-site.ts",
    "site:smoke": "vite-node scripts/site/smoke.ts",
    "reentrada:smoke": "vite-node scripts/smoke-reentrada.ts",
    "reentrada:validar": "vite-node scripts/validar-reentrada.ts"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
